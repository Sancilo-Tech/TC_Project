# Copy this file to ".env" and fill in the blanks.

# ── React app ─────────────────────────────────────────────
GENERATE_SOURCEMAP=false
# Port of the development site (npm start)
PORT=3000
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# ── Backend server ────────────────────────────────────────
# Keep 4000 unless you also change "proxy" in package.json
SERVER_PORT=4000

# Your local PostgreSQL. DB_NAME is created by "npm run db:init" if it is missing.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tc_app
DB_USER=postgres
DB_PASSWORD=

# Signs the login sessions. Use any long random text and keep it private.
# To generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The first admin login, created by "npm run db:init" while there are no users yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
